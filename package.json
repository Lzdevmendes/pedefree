{
  "name": "pedefree",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n store,admin -c blue,magenta \"npm run dev --workspace=apps/store\" \"npm run dev --workspace=apps/admin\"",
    "dev:store": "npm run dev --workspace=apps/store",
    "dev:admin": "npm run dev --workspace=apps/admin",
    "build": "npm run build --workspaces --if-present",
    "build:store": "npm run build --workspace=apps/store",
    "build:admin": "npm run build --workspace=apps/admin",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prisma:seed:gamboa": "ts-node ./prisma/seed-gamboa.ts"
  },
  "prisma": {
    "seed": "ts-node ./prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.2.1",
    "prisma": "^6.2.1"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@vitest/coverage-v8": "^5.0.0",
    "concurrently": "^9.1.2",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5",
    "vitest": "^5.0.0"
  }
}
